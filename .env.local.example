# Copier en `.env.local` (gitignoré, jamais commité — voir templates/gitignore.template)
# et remplir avec les valeurs de l'environnement ciblé.
#
# Local : lancer `supabase start` puis `npx supabase status -o env` pour obtenir les
# valeurs générées localement par Supabase (clés de démonstration propres à l'instance
# Docker locale — pas des secrets réels).
#
# Preview/dev cloud (projet Supabase "hybrideclub", eu-west-1 — 08-architecture.md §9) :
# NEXT_PUBLIC_SUPABASE_URL=https://tcfibhdhxfexyojmiwge.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_2Nu5fZow9DaYtnpu1AgAYQ_WrwnHz9S
# SUPABASE_SERVICE_ROLE_KEY=  # non transmis à `developer` — à configurer par `devops` en variable Vercel

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Connexion Postgres directe (introspection RLS dans les tests d'intégration uniquement).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protège les routes /api/v1/cron/* (08-architecture.md §6.8) : enqueue-weekly-reviews,
# enqueue-objective-checks, drain-jobs, purge-stripe-events. Fail-closed si absente
# (isAuthorizedCronRequest()) — aucune route cron ne s'exécute sans cette variable.
CRON_SECRET=

# --- Lot L3 — Onboarding conversationnel (08-architecture.md §9, apps/web/lib/coach-llm-provider.ts) ---
# Clé du fournisseur LLM (Mistral AI, ADR-010). Absente en développement ⟹ repli automatique sur le
# mock déterministe (avertissement bruyant). Absente en production ⟹ refus explicite (fail-closed,
# correction I12) : aucune conversation d'onboarding ni explication n'est générée sans elle.
MISTRAL_API_KEY=
# Force le mock déterministe hors production (utilisé par apps/web/playwright.config.ts pour les
# tests E2E — jamais d'appel réseau ni de dépendance à un quota Mistral). Sans effet en production
# (le garde NODE_ENV=production est toujours évalué en premier, correction I12).
# COACH_LLM_PROVIDER=mock

# --- Lot L5 — Stripe (08-architecture.md §6.6, ADR-009) ---
STRIPE_SECRET_KEY=
# Requis pour vérifier la signature des webhooks (apps/web/app/api/v1/webhooks/stripe/route.ts).
# Absente en production ⟹ la route répond 503 avant toute lecture (fail-closed) ; absente hors
# production ⟹ parse brut avec log bruyant (dev uniquement). Attention : NODE_ENV vaut aussi
# "production" sur les déploiements preview Vercel.
STRIPE_WEBHOOK_SECRET=
# Price ID Stripe de l'offre mensuelle — jamais de montant en dur dans le code (ADR-009 §H5).
STRIPE_PRICE_ID_MONTHLY=
# Clé publiable, exposée au client (Payment Element, apps/web/app/(app)/abonnement/page.tsx).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Lot L5 — Brevo (08-architecture.md §2, notifications e-mail — repli du rituel hebdomadaire) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# --- Lot L5 — Web Push VAPID (08-architecture.md §2, ADR-011 §5) ---
# Absentes ⟹ dégradation EXPLICITE (envoi Web Push désactivé, log dédié) ; le badge in-app et
# l'e-mail Brevo restent les canaux garantis (triple canal, R8 §12).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Non implémentée à ce jour : aucune UI d'abonnement push ni service worker n'exposent une clé
# publique au client (`NEXT_PUBLIC_VAPID_PUBLIC_KEY`) — voir reviews/US-01-coach-ia-personnalise-review.md,
# nice-to-have sur le point d'attention Web Push.
