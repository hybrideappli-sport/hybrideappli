{
  "name": "@hybride/db",
  "version": "0.0.0",
  "private": true,
  "description": "Client Supabase typé, repositories, types générés depuis le schéma (`supabase gen types typescript`).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "gen:types": "supabase gen types typescript --local > src/types.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hybride/domain": "workspace:*",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10"
  },
  "devDependencies": {
    "@types/pg": "^8.20.4",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
