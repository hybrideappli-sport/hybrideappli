# apps/web/.env.example — toutes les variables que le code lit, sans aucune valeur.
#
# Copier en `.env.local` pour le développement. En production, ces variables se définissent dans
# Vercel → hybrideappli-web → Settings → Environment Variables, environnement « Production ».
#
# Source unique : `lib/health/readiness.ts` (ENV_REQUIREMENTS). Un test échoue si ce fichier et
# cette liste divergent, ou si le code lit une variable qui n'y figure pas. Pour vérifier un
# environnement déployé : GET /api/v1/health/readiness (voir docs/pret-pour-la-prod.md).
#
# Effet d'une absence, en production :
#   [bloquant]     la fonctionnalité échoue (erreur, 500)
#   [fail closed]  l'app refuse volontairement de la servir
#   [dégradé]      l'app continue sans elle, en le journalisant

# --- Socle ------------------------------------------------------------------------------------

# [bloquant] Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# [bloquant] Domaine public, en https. Absente, le code se replie EN SILENCE sur
# http://localhost:3000 : liens d'e-mail, liens Brevo et callback Strava cassés sans erreur.
NEXT_PUBLIC_SITE_URL=

# [fail closed] Coach IA (Mistral, ADR-010). Absente en production, getLlmProvider() refuse de
# démarrer : onboarding, plans, saisies et débrief échouent. Un plan Mistral payant est requis :
# les clés du plan Free renvoient 429.
MISTRAL_API_KEY=

# [fail closed] Authentifie les crons de vercel.json et /api/v1/health/readiness.
CRON_SECRET=

# --- Abonnement (Stripe) ------------------------------------------------------------------------

# [bloquant] En production : sk_live_ / pk_live_, jamais sk_test_ / pk_test_.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Données connectées (Strava, ADR-013) -------------------------------------------------------

# [fail closed] getStravaConfig() exige les six ensemble.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_PATH_SECRET=
STRAVA_VERIFY_TOKEN=
DATA_TOKEN_ENC_KEY=
OAUTH_STATE_SECRET=

# [fail closed en production] Sans elle, le webhook refuse toute requête.
STRAVA_WEBHOOK_SUBSCRIPTION_ID=

# Optionnelles — défauts appliqués.
STRAVA_WEBHOOK_RATE_LIMIT_MAX=
STRAVA_WEBHOOK_RATE_LIMIT_WINDOW_MS=
STRAVA_WEBHOOK_SUBSCRIBE_RATE_LIMIT_MAX=

# --- Notifications (ADR-011) --------------------------------------------------------------------

# [dégradé] Sans elles, aucun e-mail. Seule la notification in_app reste garantie.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# [dégradé] Sans elles, aucune notification push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Carte (ADR-018, en pause depuis le 2026-09-10) ---------------------------------------------

# [fail closed en production] /carte refusée tant que MAP_TILES_PLAN ≠ commercial.
MAP_TILES_PLAN=
# [bloquant sur /carte] En local, le style public de démonstration suffit :
# https://demotiles.maplibre.org/style.json
MAP_TILES_STYLE_URL=
NEXT_PUBLIC_MAP_TILES_API_KEY=

# Optionnelles — défauts appliqués.
OVERPASS_CONTACT_EMAIL=
MAP_TRAILS_RATE_LIMIT_MAX=
MAP_TRAILS_RATE_LIMIT_WINDOW_MS=

# --- Local et tests uniquement — jamais en production -------------------------------------------

# Connexion Postgres directe des tests d'intégration (supabase status → DB_URL).
DATABASE_URL=

# `mock` force le coach simulé, sans appel réseau (tests, E2E). Ignorée en production par
# construction, mais sa présence y signale une configuration copiée depuis le local.
COACH_LLM_PROVIDER=
